{
  "eidos-doc-linter": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "eidos hook lint --event PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "eidos hook lint --event PostInvocation",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "eidos hook lint --event Stop",
        "timeout": 30
      }
    ]
  },
  "eidos-drift-gate": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "eidos hook drift --event PostInvocation",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "eidos hook drift --event Stop",
        "timeout": 30
      }
    ]
  }
}
