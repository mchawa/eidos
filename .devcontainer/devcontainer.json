{
  "name": "Eidos (Ubuntu 26.04)",
  "image": "ubuntu:26.04",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "asciidoctor.asciidoctor-vscode",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid"
      ]
    }
  },
  "postCreateCommand": "apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl git python3 python3-pip python3-venv && python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -e '.[dev]'"
}
