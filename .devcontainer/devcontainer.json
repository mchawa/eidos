{
  "name": "Eidos (Ubuntu 26.04)",
  "image": "ubuntu:26.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true,
      "nonFreePackages": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {
      "shellautocompletion": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "containerEnv": {
    // uv cannot use hardlinks across the /tmp → workspace boundary in Codespaces;
    // copy mode avoids "Invalid cross-device link" errors.
    "UV_LINK_MODE": "copy",
    "GITLAB_TOKEN": "${localEnv:GITLAB_TOKEN}"
  },
  "mounts": [
    "source=eidos-gemini,target=/home/vscode/.gemini,type=volume"
  ],
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        // --- Python & Astral Toolchain ---
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-python-envs",
        "charliermarsh.ruff",
        "astral-sh.ty",
        // --- Containers & Virtualization ---
        "ms-azuretools.vscode-containers",
        // --- Living Architecture & Specifications ---
        "asciidoctor.asciidoctor-vscode",
        "mathematic.vscode-pdf",
        // --- Configuration & Schemas ---
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        // --- Git & Source Control ---
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        // --- AI Agents & Harness ---
        "google.google-antigravity"
      ]
    }
  }
}
