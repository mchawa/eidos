{
  "name": "Eidos Devcontainer",
  "image": "ubuntu:26.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:latest": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true,
      "nonFreePackages": true,
      "username": "automatic",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    "ghcr.io/devcontainers/features/git:latest": {},
    "ghcr.io/devcontainers/features/git-lfs:latest": {},
    "ghcr.io/devcontainers/features/github-cli:latest": {},
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:latest": {
      "shellautocompletion": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:latest": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:latest": {
      "version": "lts",
      "pnpmVersion": "latest"
    }
  },
  "forwardPorts": [
    3000,
    5173,
    8000,
    8080
  ],
  "portsAttributes": {
    "3000": {
      "label": "Eidos Portal Server (CLI)",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Eidos Portal Frontend (Vite Dev)",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Eidos Documentation (Zensical)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Eidos Portal (Alt Port)",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    // uv cannot use hardlinks across the /tmp → workspace boundary in Codespaces;
    // copy mode avoids "Invalid cross-device link" errors.
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gemini,target=/home/ubuntu/.gemini,type=bind"
  ],
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        // --- Python & Astral Toolchain ---
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-python-envs",
        "charliermarsh.ruff",
        "astral-sh.ty",
        // --- Containers & Virtualization ---
        "ms-azuretools.vscode-containers",
        // --- Living Architecture & Specifications ---
        "asciidoctor.asciidoctor-vscode",
        "mathematic.vscode-pdf",
        // --- Configuration & Schemas ---
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        // --- Living Architecture Portal & Frontend ---
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        // --- Productivity & Spell Checking ---
        "streetsidesoftware.code-spell-checker",
        // --- Git & Source Control ---
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        // --- AI Agents & Harness ---
        "google.google-antigravity"
      ],
      "settings": {
        "[markdown]": {
          "editor.wordWrap": "on"
        },
        "markdown.validate.enabled": true,
        "markdown.validate.fileLinks.enabled": "warning",
        "markdown.validate.fragmentLinks.enabled": "warning"
      }
    }
  }
}
