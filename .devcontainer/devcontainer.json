{
  "name": "Eidos Devcontainer",
  "image": "ubuntu:26.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true,
      "nonFreePackages": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {
      "shellautocompletion": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts",
      "pnpmVersion": "latest"
    }
  },
  "forwardPorts": [3000, 5173, 8000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Eidos Portal Server (CLI)",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Eidos Portal Frontend (Vite Dev)",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Eidos Documentation (Zensical)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Eidos Portal (Alt Port)",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
    "source=eidos-gemini,target=/home/vscode/.gemini,type=volume"
  ],
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-python-envs",
        "charliermarsh.ruff",
        "astral-sh.ty",
        "ms-azuretools.vscode-containers",
        "asciidoctor.asciidoctor-vscode",
        "mathematic.vscode-pdf",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",
        "bierner.markdown-mermaid",
        "bierner.github-markdown-preview",
        "streetsidesoftware.code-spell-checker",
        "vstirbu.vscode-mermaid-preview",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "google.google-antigravity"
      ],
      "settings": {
        "[markdown]": {
          "editor.defaultFormatter": "yzhang.markdown-all-in-one",
          "editor.wordWrap": "on"
        },
        "markdownlint.config": {
          "MD013": false,
          "MD033": false
        }
      }
    }
  }
}
